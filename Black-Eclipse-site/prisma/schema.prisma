// JDDS — Joint Data Distribution System
// SQLite-backed data vault. Stores scraped market data once and distributes
// it to every screen. Zero-config (local file DB).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A market / exchange (e.g. US, Pakistan, India, China, Crypto).
model Market {
  id        String   @id
  country   String   @unique // 'US', 'PK', 'IN', 'CN', 'CRYPTO', ...
  exchange  String
  timezone  String
  openHour  Int
  closeHour Int
  enabled   Boolean  @default(true)
  isCrypto  Boolean  @default(false)
  createdAt DateTime @default(now())
  assets    Asset[]
}

// A single tradable asset belonging to a market.
// Dedup: the @@unique([marketId, symbol]) constraint guarantees at most one
// asset per (market, symbol) — re-importing the same symbol updates in place
// instead of creating a duplicate.
model Asset {
  id           String   @id @default(cuid())
  symbol       String
  name         String
  marketId     String
  sector       String?
  industry     String?
  country      String?
  // Security type / asset class from the market universe (e.g. 'Common Stock',
  // 'ETF', 'Mutual Fund', 'ADR', 'Preferred Stock', 'Warrant', ...).
  securityType String?
  assetClass   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  price  Price?

  @@unique([marketId, symbol])
  @@index([marketId, isActive])
  @@index([sector])
  @@index([industry])
  @@index([securityType])
  @@index([country])
}

// Latest price for an asset.
// source: 'scraper' (live scrape) or 'csv' (imported historical/API data).
model Price {
  assetId           String   @id
  price             Float
  changePct         Float
  marketCap         Float?
  volume            Float?
  peRatio           Float?
  // Richer fundamentals from yfinance (stocks).
  forwardPE         Float?
  dividendYield     Float? // percent, e.g. 2.5
  dividendRate      Float?
  eps               Float?
  beta              Float?
  dayHigh           Float?
  dayLow            Float?
  open              Float?
  previousClose     Float?
  fiftyTwoWeekHigh  Float?
  fiftyTwoWeekLow   Float?
  // Crypto-specific fields (crypto market only).
  rank              Float?
  fdv               Float?
  circulatingSupply Float?
  totalSupply       Float?
  maxSupply         Float?
  ath               Float?
  atl               Float?
  athChangePct      Float?
  atlChangePct      Float?
  source            String   @default("scraper")
  updatedAt         DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([marketCap])
  @@index([price])
  @@index([changePct])
  @@index([volume])
  @@index([peRatio])
}

// Cached index quotes per market, stored in JDDS so page loads never hit the
// network. Refreshed in the background by the scheduler.
model IndexQuote {
  id        String   @id @default(cuid())
  marketId  String
  symbol    String
  name      String
  price     Float
  change    Float
  changePct Float
  updatedAt DateTime @updatedAt

  @@unique([marketId, symbol])
}

// Cached news items ingested from RSS feeds in the background, so /api/news
// reads from JDDS instead of hitting every feed live on each request.
model NewsItem {
  id        String   @id @default(cuid())
  source    String
  ticker    String?
  headline  String
  summary   String?
  sentiment String   @default("neutral")
  timestamp DateTime
  url       String?
  // Feed metadata so filters (category/region/tier) work without refetching.
  category  String?
  region    String?
  tier      Int?
  // Dedup key: hash of url (or headline) — upserts are idempotent across runs.
  dedupKey  String   @unique

  @@index([timestamp])
  @@index([category])
  @@index([region])
  @@index([sentiment])
  @@index([ticker])
}

// Learned source reliability — powers self-healing source rotation.
model SourceHealth {
  id            String    @id @default(cuid())
  source        String // strategy id, e.g. 'http', 'browser', 'search', 'crypto'
  market        String
  symbol        String // '*' for whole-market default
  successCount  Int       @default(0)
  failCount     Int       @default(0)
  lastStatus    String
  lastError     String?
  // Per-route timestamps. `updatedAt` is "last attempt" (conflated); these
  // separate the last SUCCESS from the last FAILURE so a report reader can tell
  // "failing now" from "succeeded earlier then had a transient failure".
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([source, market, symbol])
}

// User-configured cron jobs.
model CronJob {
  id              String    @id @default(cuid())
  type            String    @unique // 'price_refresh', 'universe_sync'
  intervalMinutes Int       @default(15)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  enabled         Boolean   @default(true)
}

// Slow-moving macro-economic series cached from external providers so the
// Economics page loads instantly from JDDS and refreshes in the background.
model MacroSeries {
  id        String   @id @default(cuid())
  cacheKey  String   @unique // source + params hash
  source    String
  seriesKey String // indicator / series id / label
  payload   String // JSON: normalized { date, value, ...rest } rows
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

// Cached normalized fundamentals snapshot per symbol. The full Eclipse
// snapshot (statements + derived metrics + insights) is stored as JSON so the
// Fundamentals page loads instantly from JDDS and providers are hit only when
// the cache is stale. `primarySource` records which provider supplied the
// statements; `payload` is the provider-merged, UI-ready document.
model FundamentalsCache {
  id            String   @id @default(cuid())
  symbol        String
  market        String
  primarySource String
  payload       String // JSON: FundamentalsSnapshot
  fetchedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([symbol, market])
  @@index([primarySource])
  @@index([updatedAt])
}

// Key-value system/user config.
model SystemConfig {
  key   String @id
  value String
}

// ─── Agentic Research Memory ─────────────────────────────────────────
// Persists what the research agents did so they can cite past findings,
// avoid redoing work, and "self-heal" (retry failed tool calls).

// A single research run triggered by a user query (e.g. "research PSX").
model ResearchReport {
  id         String            @id @default(cuid())
  query      String // the user's original request
  ticker     String? // primary symbol researched, if any
  market     String? // 'US', 'PK', 'IN', 'CRYPTO', ...
  status     String            @default("running") // running | done | failed
  summary    String? // final synthesized answer
  verdict    String? // e.g. 'bullish' | 'bearish' | 'neutral' | 'hold'
  confidence Float? // 0..1
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  runs       AgentRun[]
  findings   ResearchFinding[]
}

// A log of one agent's work within a report (tool calls + outcomes).
model AgentRun {
  id         String    @id @default(cuid())
  reportId   String
  agent      String // 'orchestrator' | 'news' | 'fundamentals' | 'technical' | 'risk'
  status     String    @default("running") // running | done | failed
  toolCalls  Int       @default(0)
  toolErrors Int       @default(0)
  output     String? // agent's raw output / notes
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  report ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ─── Price & Condition Alerts ────────────────────────────────────────────
// A "watch" = a boolean condition tree over market data, evaluated on a
// server-side poll loop. When it fires, we dispatch via configured channels
// and log a PriceAlertEvent. Deleting a watch must NOT delete its events
// (no cascade on purpose — history survives).

// One alert rule (the watch).
model PriceAlert {
  id          String    @id @default(cuid())
  name        String
  symbols     String // JSON string[]
  market      String    @default("US")
  universe    String    @default("CUSTOM") // CUSTOM | MARKET
  conditions  String // JSON condition tree (leaf | group)
  logic       String    @default("AND") // AND | OR (top-level group)
  timeframe   String    @default("1d") // 1m 5m 15m 1h 1d
  dataSource  String    @default("Auto") // TradingView | yfinance | Auto
  mode        String    @default("poll") // poll (websocket = FUTURE)
  intervalSec Int       @default(60) // poll floor 30s
  cooldownMin Int       @default(15)
  actions     String    @default("{}") // JSON { toast?, channels?: string[] }
  active      Boolean   @default(true)
  status      String    @default("idle") // idle|warming|watching|triggered|error
  statusMsg   String?
  lastEvalAt  DateTime?
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// History - one row per fired alert. NOT cascade-deleted with the watch.
model PriceAlertEvent {
  id      String   @id @default(cuid())
  alertId String
  symbol  String
  detail  String
  firedAt DateTime @default(now())

  @@index([alertId])
  @@index([firedAt])
}

// Durable archive of the app-wide notification ledger (the header bell).
// Every raised notification — price/news alerts, tasks, approvals, agent runs,
// bots — is written here with the producer's stable dedupe key as `id`, so the
// Alerts › History tab can search and filter everything ever received, and a
// re-raise never duplicates a row. PriceAlertEvent remains the price-alert
// engine's fire log; the history endpoint unions the two for legacy rows.
model AppNotification {
  id        String   @id
  tab       String
  kind      String   @default("alert") // alert | task | approval | agent | bot
  title     String
  body      String   @default("")
  at        DateTime @default(now())
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([at])
  @@index([kind])
  @@index([tab])
}

// Candle cache for indicator conditions (SMA/EMA/RSI crossovers).
// Only cached per-watch for the symbols/timeframes that need it.
model Candles {
  symbol    String
  timeframe String
  ts        DateTime
  o         Float
  h         Float
  l         Float
  c         Float
  v         Float?

  @@id([symbol, timeframe, ts])
}

// A discrete fact / data point an agent gathered (for citation + memory).
model ResearchFinding {
  id        String   @id @default(cuid())
  reportId  String
  agent     String
  kind      String // 'price' | 'news' | 'fundamental' | 'technical' | 'risk' | 'search'
  ticker    String?
  title     String
  detail    String
  source    String?
  url       String?
  createdAt DateTime @default(now())

  report ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ─── Trading Journal ─────────────────────────────────────────────────────
// SQLite-backed trading journal + performance intelligence. Every trade
// becomes structured data the analytics engine (and later the Agentic
// Harness) can reason over.
//
// The app is currently a guest/localStorage app with no auth model. These
// models are designed so a `userId` can be added later without a breaking
// rewrite: each top-level journal model carries an optional `owner` string
// (defaults to the single guest). When auth lands, add a User relation and
// scope queries by owner.

// The journal owner (guest profile). One row per user; the guest uses the
// default. Kept separate from auth so the journal works today and can be
// linked to a real User later.
model JournalProfile {
  id           String   @id @default(cuid())
  // Auth user id when authentication is active. Null = the shared guest
  // profile used by the zero-config local app. The profile id is deterministic
  // for an auth user (`jp_<userId>`), so concurrent first requests converge
  // without needing a unique constraint on this nullable column.
  userId       String?
  name         String   @default("Trader")
  currency     String   @default("USD")
  // Default risk per trade (fraction of account, e.g. 0.01 = 1%).
  riskPerTrade Float    @default(0.01)
  accountSize  Float    @default(10000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts          TradingAccount[]
  strategies        Strategy[]
  setups            Setup[]
  tags              Tag[]
  days              JournalDay[]
  trades            Trade[]
  entries           JournalEntry[]
  reviews           Review[]
  watchlist         WatchlistItem[]
  brokerLinks       JournalBrokerLink[]
  attributionRules  BrokerAttributionRule[]

  @@index([userId])
}

// A trading account the journal tracks P&L against.
model TradingAccount {
  id             String   @id @default(cuid())
  profileId      String
  name           String
  broker         String?
  currency       String   @default("USD")
  initialBalance Float    @default(0)
  archived       Boolean  @default(false)
  // Optional binding to a durable broker connection in the Python harness
  // (`BrokerConnection.id`). The connection itself lives in agent-memory.db;
  // this is only the identity used to project its trades into the journal.
  brokerConnectionId String?
  brokerLogin         Int?
  brokerServer        String?
  createdAt      DateTime @default(now())

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trades  Trade[]
  links   JournalBrokerLink[]

  @@index([profileId])
  @@index([profileId, brokerConnectionId])
}

// Binds one broker connection to the journal. The broker stays authoritative;
// this row only says how to project its deals into journal trades.
model JournalBrokerLink {
  id             String   @id @default(cuid())
  profileId      String
  // Python harness `BrokerConnection.id`. No credential ever lives here.
  connectionId   String
  accountId      String?
  enabled        Boolean  @default(true)
  autoSync       Boolean  @default(false)
  // How far back a first/repair sync should ask the broker for deals.
  backfillDays   Int      @default(90)
  lastDealAt     Int?
  lastSyncedAt   DateTime?
  // 'never' | 'ok' | 'error' | 'unavailable'
  lastSyncStatus String   @default("never")
  lastError      String?
  /// JSON: { "EURUSD.a": "EURUSD" }
  symbolMap      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account TradingAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([profileId, connectionId])
  // One trading account maps to at most one broker connection. SQLite allows
  // multiple NULLs, so unassigned links remain possible.
  @@unique([profileId, accountId])
  @@index([profileId])
}

// Turns broker metadata (magic number / comment / symbol) into journal
// attribution (strategy, setup, tags). Rules are user-editable and applied at
// projection time; they never overwrite a user's own attribution once set.
model BrokerAttributionRule {
  id           String   @id @default(cuid())
  profileId    String
  connectionId String?
  magic        Int?
  // Case-insensitive substring match on the broker deal comment.
  commentMatch String?
  // Case-insensitive glob, `*` wildcard (e.g. "XAU*").
  symbolMatch  String?
  strategyId   String?
  setupId      String?
  /// JSON string[] of tag names to seed.
  tagNames     String?
  priority     Int      @default(0)
  createdAt    DateTime @default(now())

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, connectionId, priority])
}

// A trading strategy / playbook. Rules are stored as structured rows so the
// analytics engine can score strategy compliance deterministically.
model Strategy {
  id           String   @id @default(cuid())
  profileId    String
  name         String
  description  String?
  markets      String // JSON string[] — markets this strategy trades
  confirmation String? // e.g. '15m'
  entry        String? // e.g. '1m'
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rules   StrategyRule[]
  trades  Trade[]

  @@index([profileId])
}

// A single rule within a strategy (e.g. "Risk <= 1%", "Minimum 2R").
model StrategyRule {
  id         String   @id @default(cuid())
  strategyId String
  text       String
  category   String? // 'entry' | 'risk' | 'exit' | 'management'
  createdAt  DateTime @default(now())

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

// A named setup (e.g. "BOS + FVG", "Order Block", "Breakout").
model Setup {
  id        String   @id @default(cuid())
  profileId String
  name      String
  createdAt DateTime @default(now())

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trades  Trade[]

  @@unique([profileId, name])
  @@index([profileId])
}

// A free-form tag applied to trades (e.g. "overtrade", "revenge", "news").
model Tag {
  id        String   @id @default(cuid())
  profileId String
  name      String
  createdAt DateTime @default(now())

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trades  TradeTag[]

  @@unique([profileId, name])
  @@index([profileId])
}

// One trading day. Exists so a day can have a journal even with no trades.
model JournalDay {
  id        String   @id @default(cuid())
  profileId String
  date      DateTime // date-only (UTC midnight)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  review  DailyReview?
  emotion DailyEmotion?
  trades  Trade[]

  @@unique([profileId, date])
  @@index([profileId, date])
}

// Pre-market / post-market written review for a day.
model DailyReview {
  id               String   @id @default(cuid())
  dayId            String
  marketBias       String? // 'Bullish' | 'Bearish' | 'Neutral' | ...
  tradingPlan      String? // rich text / markdown
  marketsWatching  String? // JSON string[]
  keyLevels        String? // rich text / structured
  wentWell         String?
  wentWrong        String?
  followedStrategy String?
  biggestMistake   String?
  lesson           String?
  tomorrow         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  day JournalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId])
}

// Emotional state recorded for a day.
model DailyEmotion {
  id         String   @id @default(cuid())
  dayId      String
  state      String? // 'Calm' | 'Focused' | 'Nervous' | ...
  confidence Int? // 1-5
  discipline Int? // 1-5
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  day JournalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId])
}

// A single trade. Core fields are denormalized for fast analytics; the
// execution log (TradeExecution) preserves the full history of changes.
model Trade {
  id         String  @id @default(cuid())
  profileId  String
  accountId  String?
  dayId      String?
  strategyId String?
  setupId    String?

  symbol     String
  direction  String // 'LONG' | 'SHORT'
  entry      Float
  // Null while the position is open. Set when the trade is closed; `status`
  // then flips to 'closed' and derived P&L becomes non-zero.
  exit       Float?
  stopLoss   Float?
  takeProfit Float?
  quantity   Float
  entryTime  DateTime
  exitTime   DateTime?

  // Optional structured context.
  timeframe    String? // '1m' | '5m' | '15m' | '1h' | '1d' | ...
  session      String? // 'Asia' | 'London' | 'New York' | ...
  marketRegime String? // 'Trending' | 'Ranging' | ...
  trend        String? // 'Bullish' | 'Bearish' | 'Neutral'
  confluences  Int? // number of confluences
  emotion      String? // 'Calm' | 'FOMO' | 'Revenge' | ...
  confidence   Int? // 1-5
  mistakes     String? // JSON string[]
  notes        String?
  // Optional per-trade letter grade (A–F) and pre-trade checklist state.
  grade        String?
  checklist    String? // JSON: { ruleId: boolean }
  status       String  @default("closed") // 'open' | 'closed'
  // Provenance: 'manual' (user-entered or CSV-imported) vs 'demo' (seeded
  // sample data) vs 'broker' (projected from a reconciled broker deal).
  // Demo rows are real records but clearly labelled, and can be removed
  // without touching anything the user created.
  source       String  @default("manual")

  // ── Broker provenance (only set for source='broker') ──────────────────
  // Stable dedupe key: "mt5:<connectionId>:<positionTicket>". Unique per
  // profile so a repeated sync is idempotent and never duplicates a trade.
  externalId           String?
  brokerConnectionId   String?
  brokerPositionTicket Int?
  // Broker attribution metadata, copied from the position's first deal/snapshot.
  magic                Int?
  // 'computed' = derived from entry/exit/qty; 'broker' = the broker's own
  // net profit is authoritative (forex/CFD cannot be recomputed this way).
  pnlBasis             String  @default("computed")
  // Set when the user explicitly deletes a broker-sourced trade; sync then
  // leaves that externalId alone instead of resurrecting it.
  ignoredAt            DateTime?

  // ── Auto-computed metrics (never user-entered) ────────────────────────
  // Gross P&L excludes costs; `pnl` is NET (gross − commission − fee).
  grossPnl     Float?
  commission   Float   @default(0)
  fee          Float   @default(0)
  pnl          Float
  pnlPct       Float
  rMultiple    Float
  riskAmount   Float?
  rewardAmount Float?
  actualRR     Float?
  durationSec  Int?
  mfe          Float? // max favorable excursion (R)
  mae          Float? // max adverse excursion (R)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       JournalProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account       TradingAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  day           JournalDay?       @relation(fields: [dayId], references: [id], onDelete: SetNull)
  strategy      Strategy?         @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  setup         Setup?            @relation(fields: [setupId], references: [id], onDelete: SetNull)
  executions    TradeExecution[]
  fills         TradeFill[]
  screenshots   TradeScreenshot[]
  annotations   TradeAnnotation[]
  tags          TradeTag[]
  marketContext MarketContext?

  @@unique([profileId, externalId])
  @@index([profileId, entryTime])
  @@index([profileId, symbol])
  @@index([profileId, strategyId])
  @@index([profileId, setupId])
  @@index([profileId, session])
  @@index([profileId, dayId])
  @@index([brokerConnectionId, brokerPositionTicket])
}

// One broker deal projected into a journal trade. The broker's `BrokerFill`
// remains the authoritative copy in the Python harness; this is the journal's
// read-only projection so the trade detail can show partials and scale-outs.
// Deals are immutable, so a repeated sync only inserts missing tickets.
model TradeFill {
  id             String   @id @default(cuid())
  tradeId        String
  dealTicket     Int
  orderTicket    Int?
  positionTicket Int?
  side           String // 'buy' | 'sell'
  entry          String // 'in' | 'out' | 'inout' | 'out_by' | 'unknown'
  volume         Float
  price          Float
  commission     Float    @default(0)
  swap           Float    @default(0)
  profit         Float    @default(0)
  magic          Int      @default(0)
  comment        String?
  dealtAt        DateTime
  createdAt      DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId, dealTicket])
  @@index([tradeId, dealtAt])
}

// Event-sourcing-ready execution log. Each change to a trade (entry modified,
// stop moved, partial exit, final exit, closed) appends a row. This powers
// future behavioral analytics (did they move their stop? take profit early?).
model TradeExecution {
  id        String   @id @default(cuid())
  tradeId   String
  kind      String // 'created' | 'entry_modified' | 'stop_modified' | 'target_modified' | 'partial_exit' | 'final_exit' | 'closed'
  detail    String? // JSON snapshot of the change
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

// A screenshot attached to a trade (before/during/after).
model TradeScreenshot {
  id        String   @id @default(cuid())
  tradeId   String
  url       String
  phase     String? // 'before' | 'during' | 'after'
  caption   String?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

// A chart annotation on a trade (entry, stop, target, FVG, BOS, ...).
model TradeAnnotation {
  id        String   @id @default(cuid())
  tradeId   String
  kind      String // 'entry' | 'stop' | 'target' | 'fvg' | 'bos' | 'order_block' | 'vwap' | 'support' | 'resistance'
  label     String?
  x         Float?
  y         Float?
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
}

// Join table: trade ↔ tag.
model TradeTag {
  tradeId String
  tagId   String

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
  @@index([tagId])
}

// Market context auto-associated with a trade (decoupled from any provider).
model MarketContext {
  id               String   @id @default(cuid())
  tradeId          String
  trend            String?
  vwap             String? // 'above' | 'below'
  ema50AboveEma200 Boolean?
  adx              Float?
  atr              Float?
  regime           String?
  volatility       String? // 'low' | 'medium' | 'high'
  session          String?
  raw              String? // JSON provider payload
  createdAt        DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@unique([tradeId])
}

// A free-form journal entry (not tied to a specific day/trade).
model JournalEntry {
  id        String   @id @default(cuid())
  profileId String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

// A watchlist item / pre-trade idea / pending order. Distinct from Trade:
// it has no execution yet, just an intent with an optional trigger level.
model WatchlistItem {
  id         String   @id @default(cuid())
  profileId  String
  symbol     String
  direction  String   @default("LONG") // 'LONG' | 'SHORT'
  idea       String? // free-text thesis
  trigger    Float? // pending-entry price level
  stopLoss   Float?
  takeProfit Float?
  status     String   @default("watching") // 'watching' | 'triggered' | 'entered' | 'expired'
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
}

// A review (weekly, monthly, or AI-generated trade review).
model Review {
  id          String    @id @default(cuid())
  profileId   String
  kind        String // 'weekly' | 'monthly' | 'trade' | 'ai'
  periodStart DateTime?
  periodEnd   DateTime?
  tradeId     String?
  title       String
  body        String // markdown / rich text
  verdict     String?
  source      String    @default("manual") // 'manual' | 'ai'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile JournalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, kind])
  @@index([profileId, createdAt])
}

// --- Universal Data Connector Layer -----------------------------------
// Operator-configured external REST data sources. Deliberately SEPARATE from
// the canonical market tables (Asset/Price/Candles) � custom data must never
// overwrite scraper-sourced rows. Structured values are stored as JSON strings
// (Prisma + SQLite has no Json/enum type here); statuses are plain strings.

// One operator-configured connector (a declarative REST endpoint).
model DataConnector {
  id              String  @id @default(cuid())
  name            String
  description     String?
  baseUrl         String
  path            String
  capabilities    String // JSON: string[] of capabilities
  params          String  @default("[]") // JSON: CustomParam[]
  headers         String  @default("{}") // JSON: Record<string,string>
  authScheme      String  @default("none") // 'none' | 'api_key' | 'bearer' | 'basic'
  authHeader      String? // header name for api_key
  authUsername    String? // username for basic
  secretEncrypted String? // AES-GCM payload; never plaintext, never returned
  enabled         Boolean @default(true)

  // Health (application-level strings � no Prisma enum).
  healthState    String    @default("UNAVAILABLE")
  lastTested     DateTime?
  lastSuccess    DateTime?
  lastError      String?
  lastHttpStatus Int?
  lastLatencyMs  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  datasets CustomDataset[]
  mappings ConnectorMapping[]

  @@index([enabled])
}

// A custom dataset produced by a connector (or defined manually).
model CustomDataset {
  id          String   @id @default(cuid())
  connectorId String?
  name        String   @unique
  description String?
  recordPath  String   @default("$") // e.g. 'results[*]'
  timestampField String?
  // Default parameter values used by SCHEDULED pulls. A value may be a
  // comma-separated list, which the runtime expands into one request per value
  // (bounded — see connectors/refresh.ts). Manual pulls pass their own values.
  pullParams  String   @default("{}") // JSON: Record<string,string>
  refreshEnabled    Boolean   @default(false)
  refreshIntervalMin Int      @default(60)
  lastRefreshAt DateTime?
  nextRefreshAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connector   DataConnector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  fields      CustomDatasetField[]
  records     CustomDatasetRecord[]

  @@index([connectorId])
  @@index([refreshEnabled])
}

// Field metadata for a custom dataset (type + source JSON path).
model CustomDatasetField {
  id          String  @id @default(cuid())
  datasetId   String
  name        String
  fieldType   String // 'string' | 'number' | 'boolean' | 'datetime' | 'json'
  sourcePath  String
  required    Boolean @default(false)
  identity    Boolean @default(false) // participates in recordKey
  unit        String?
  description String?
  position    Int     @default(0)

  dataset CustomDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, name])
  @@index([datasetId])
}

// A mapped record. `values` is a JSON string (never a Prisma Json column).
// Deterministic identity: (datasetId, recordKey) is unique, so re-importing the
// same response upserts instead of duplicating.
model CustomDatasetRecord {
  id          String   @id @default(cuid())
  datasetId   String
  recordKey   String
  values      String // JSON: Record<string, unknown>
  provenance  String   @default("CUSTOM") // 'CUSTOM' | 'LIVE' | 'HISTORICAL'
  retrievedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dataset CustomDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, recordKey])
  @@index([datasetId])
}

// ─── Investor Eye — world-state intelligence ───────────────────────────
// A financial/geopolitical "God's Eye": normalized events, country entities,
// and the relationships between them. Additive to JDDS — no existing model is
// altered. JSON is stored as strings and statuses as plain strings, matching
// the DataConnector/CustomDataset convention (SQLite + Prisma has no Json/enum).
// See docs/investor-eye-architecture.md and ADR-011.

// A canonical country entity. Deliberately does NOT replace `Market.country`
// or `Asset.country` (both plain strings); those are joined by ISO code.
model Country {
  id        String   @id @default(cuid())
  iso2      String   @unique // 'US', 'PK', 'TW', ...
  iso3      String?  @unique // 'USA', 'PAK', ...
  name      String
  // Name the Natural Earth GeoJSON feature uses, so a country entity can be
  // matched to a map feature without a hand-maintained lookup table.
  mapName   String?
  region    String? // 'North America' | 'South Asia' | ...
  // Approximate centroid [lon, lat] — used to anchor country-level events
  // that carry no precise coordinates.
  lon       Float?
  lat       Float?
  // Optional link into the existing market system (do NOT duplicate it).
  marketId  String?
  currency  String?
  aliases   String   @default("[]") // JSON: string[] of alternate names
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events EventEntity[]

  @@index([mapName])
  @@index([region])
  @@index([marketId])
}

// A normalized geopolitical / economic event. One row per CLUSTERED event —
// not one per article. `dedupKey` is unique so re-ingestion is an idempotent
// upsert; `sourceCount` grows as independent sources confirm the same event.
model GeopoliticalEvent {
  id          String   @id @default(cuid())
  // Stable identity for dedup: hash of normalized (type + country + time
  // bucket + title signature). Unique → upserts, never duplicates.
  dedupKey    String   @unique

  title       String
  summary     String?
  // A REAL article headline / description, when the source provides one.
  // GDELT has neither (only URLs), so these stay null rather than being
  // synthesized — a fabricated headline would read as reporting that does not
  // exist. Populated by news-corpus enrichment.
  headline    String?
  description String?
  // JSON: EventActor[] — { name, countryCode?, typeCode? } from the provider.
  actors      String   @default("[]")
  // JSON: { cameoRoot?, goldstein? } — provider codes kept verbatim.
  providerCodes String @default("{}")
  // Place name the coordinates resolved to, plus HOW they were determined:
  // provider | place | centroid. Lets the UI avoid implying false precision.
  placeName   String?
  geoMethod   String?
  // conflict | military | protest | election | diplomatic | sanction | trade |
  // tariff | cyber | energy | shipping | natural_disaster | monetary | fiscal |
  // regulatory | other
  eventType   String
  // Provider sub-classification, when the type alone is too coarse. Currently
  // the hazard sub-types: 'earthquake' (USGS) | 'fire' (FIRMS). Set only from a
  // provider that states it — never inferred from text.
  category    String?
  // low | medium | high | critical
  severity    String   @default("medium")
  // JSON: string[] of economic channels this event could transmit through.
  channels    String   @default("[]")
  commodities String   @default("[]") // JSON: string[]
  sectors     String   @default("[]") // JSON: string[]
  securities  String   @default("[]") // JSON: string[]
  // JSON: string[] — canonical country ISO2 codes for the event.
  countries   String   @default("[]")
  // Primary geographic anchor (denormalized for fast map queries).
  lon         Float?
  lat         Float?

  // Data-quality confidence (NOT scientific certainty). 0..1.
  confidence  Float    @default(0.5)
  // Investor relevance (see lib/investor-eye/relevance.ts). Distinct from
  // confidence: relevance = "does this matter to a portfolio", confidence =
  // "how well corroborated is it". 0..1.
  relevance   Float    @default(0)
  // JSON: string[] — why it scored that relevance (shown in the UI).
  relevanceReasons String @default("[]")
  sourceCount Int      @default(1)
  // JSON: SourceRef[] — { id, name, url, publishedAt }.
  sources     String   @default("[]")
  // Origin connector id ('gdelt', 'usgs', ...) — the primary source.
  primarySource String

  publishedAt DateTime
  firstSeen   DateTime @default(now())
  lastUpdated DateTime @updatedAt
  status      String   @default("active") // active | archived

  entities EventEntity[]

  @@index([publishedAt])
  @@index([eventType])
  @@index([severity])
  @@index([status])
  @@index([primarySource])
  // The feed is ranked by relevance, so it must be cheap to sort/filter on.
  @@index([relevance])
}

// Event ↔ entity join. Keeps events queryable by country/actor/location/
// commodity/etc. without packing a graph into one JSON column.
model EventEntity {
  id        String   @id @default(cuid())
  eventId   String
  // country | actor | location | commodity | sector | security | market
  kind      String
  // Canonical identifier for the entity (ISO2 for countries, else a slug).
  entityId  String
  name      String
  // Optional exact position when the entity is a place (more precise than the
  // event's country anchor).
  lon       Float?
  lat       Float?
  createdAt DateTime @default(now())

  event    GeopoliticalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  country  Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  countryId String?

  @@index([eventId])
  @@index([kind, entityId])
  @@index([countryId])
}

// A typed, directed edge between two Investor Eye entities (the knowledge /
// relationship graph, spec §41). Relational — deliberately NOT a graph
// database (ADR-011).
//
// Entities are identified by a `kind` + `entityId` pair so the graph can join
// countries, companies, commodities, sectors, markets, events and securities
// without a table per pairing. `relation` is the edge type; `relationClass`
// records HOW the link was established so the UI never presents an inference
// as a fact:
//   OBSERVED       both endpoints appear in the same source record
//   HISTORICAL     derived from real stored price history
//   INFERRED       produced by an explicit, documented rule
//   AI-INTERPRETED produced by the agent layer
model Relationship {
  id            String   @id @default(cuid())
  // Deterministic identity so re-ingestion upserts instead of duplicating.
  edgeKey       String   @unique

  fromKind      String   // country | company | commodity | sector | market | event | security
  fromId        String   // ISO2 for countries, symbol for companies/securities, slug otherwise
  fromName      String
  toKind        String
  toId          String
  toName        String

  // e.g. 'mentions' | 'exposed_to' | 'trades_with' | 'part_of' | 'affected_by'
  relation      String
  relationClass String   @default("OBSERVED")

  // 0..1 — strength/weight of the edge (co-mention count, exposure share, …).
  weight        Float    @default(1)
  // JSON: evidence refs ({ eventId?, source?, url?, note? }).
  evidence      String   @default("[]")
  // Optional provenance tag for the edge's data (LIVE | HISTORICAL | …).
  provenance    String   @default("LIVE")

  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([fromKind, fromId])
  @@index([toKind, toId])
  @@index([relation])
  @@index([relationClass])
}

// One row per ingestion run per source. Powers Data Health + observability.
model SourceRun {
  id              String   @id @default(cuid())
  source          String // connector id: 'gdelt' | 'usgs' | ...
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  status          String   @default("running") // running | ok | error | empty
  recordsReceived Int      @default(0)
  recordsAccepted Int      @default(0)
  recordsRejected Int      @default(0)
  error           String?
  latencyMs       Int?

  @@index([source, startedAt])
  @@index([status])
}

// A saved mapping from a dataset response onto a canonical concept. Recorded
// for auditability; canonical writes are NOT performed automatically.
model ConnectorMapping {
  id          String   @id @default(cuid())
  connectorId String
  datasetId   String?
  target      String // canonical concept, e.g. 'Price'
  mapping     String // JSON: { sourcePath: targetField }
  createdBy   String   @default("operator")
  createdAt   DateTime @default(now())

  connector DataConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
}

// -- Investment Thesis Tracker (Workstream K) ---------------------------------
// A persistent, versioned investment thesis. The ORIGINAL hypothesis is never
// silently rewritten: every edit appends a ThesisRevision snapshot, so an old
// view can always be reconstructed. Evidence (supporting/contradicting) is a
// first-class relation with its own provenance.
model Thesis {
  id            String    @id @default(cuid())
  symbol        String
  marketId      String
  companyName   String?
  title         String
  hypothesis    String
  status        String    @default("active") // active | weakening | broken | closed
  // JSON arrays (SQLite has no array columns).
  assumptions   String    @default("[]") // string[]
  catalysts     String    @default("[]") // string[]
  risks         String    @default("[]") // string[]
  metrics       String    @default("[]") // string[]  (metrics to monitor)
  reviewDate    DateTime?
  version       Int       @default(1)
  sourceArtifacts String  @default("[]") // string[] artifact ids
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  evidence  ThesisEvidence[]
  revisions ThesisRevision[]

  @@index([symbol, marketId])
  @@index([status])
}

model ThesisEvidence {
  id          String    @id @default(cuid())
  thesisId    String
  stance      String // supporting | contradicting
  summary     String
  sourceUrl   String?
  sourceType  String? // filing | news | web | calculation | user
  publishedAt DateTime?
  retrievedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  thesis Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@index([stance])
}

model ThesisRevision {
  id         String   @id @default(cuid())
  thesisId   String
  version    Int
  snapshot   String // JSON snapshot of the thesis at this version
  note       String?
  createdAt  DateTime @default(now())

  thesis Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@unique([thesisId, version])
  @@index([thesisId])
}

// ─── Graph Studio — visual workflow documents ───────────────────────────────
// The visual graph-engineering studio's persisted documents. This is the
// AUTHORING/CONTAINER layer (name, tags, ownership) over the canonical Eclipse
// Workflow IR. A `Workflow` is a named container; `WorkflowVersion` stores an
// IMMUTABLE snapshot of the canonical IR as JSON. Versions are append-only, so
// a version that was opened or (later) deployed is never silently rewritten —
// editing always produces the next version. The IR is validated in the editor
// and re-validated server-side before a version is written.
//
// Deliberately separate from the Python runtime's `WorkflowDefinition` table
// (agent-memory.db), which persists the step-plan `Workflow` model used by the
// orchestration engine. These are the graph documents a human draws; that is
// the compiled plan the runtime runs.
model Workflow {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  tags           String   @default("[]") // JSON: string[]
  owner          String   @default("guest")
  currentVersion Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions  WorkflowVersion[]
  schedules WorkflowSchedule[]
  webhooks  WorkflowWebhook[]

  @@index([owner, updatedAt])
  @@index([archived])
}

// Durable presentation state for Bots mode: the per-bot chat threads (`chat`)
// and the group rooms incl. their transcripts (`groups`). The JSON document is
// the fast hydration snapshot; the per-message tables below are the recovery
// record. `stateUpdatedAt` is the CLIENT's ISO timestamp of the document
// contents and is what lets a tab decide whether local or remote is newer; the
// API refuses an older write so a stale tab cannot roll the transcript back.
model BotState {
  key            String   @id
  document       String
  stateUpdatedAt String
  revision       Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@map("BotState")
}

// Per-message durable log for Bots mode. `BotState` remains the fast
// presentation snapshot; these rows are the recovery/audit source of truth for
// a conversation. An id is the client's message id, so an append is idempotent
// and a terminal streaming update becomes an upsert of the same row.
model BotChatMessage {
  id        String   @id
  botId     String
  role      String
  content   String
  at        String
  scheduled Boolean  @default(false)
  runId     String?
  error     Boolean  @default(false)
  feedback  String?
  /// JSON for delegations / pending approval / pending clarification.
  payload   String?
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([botId, at])
  @@map("BotChatMessage")
}

model BotGroupMessage {
  id         String   @id
  groupId    String
  role       String
  content    String
  at         String
  authorId   String?
  authorName String?
  scheduled  Boolean  @default(false)
  runId      String?
  error      Boolean  @default(false)
  feedback   String?
  /// JSON for delegations / pending approval / pending clarification.
  payload    String?
  revision   Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@index([groupId, at])
  @@map("BotGroupMessage")
}

// Room identity and membership. `BotState` remains the instant snapshot, but a
// lost/cleared snapshot must not orphan a durable transcript. The room row is
// authoritative for name/members/mode/chair; images are bounded data URLs.
model BotRoom {
  id        String   @id
  name      String
  /// JSON array of member bot ids.
  memberIds String
  mode      String   @default("parallel")
  leadId    String?
  image     String?
  createdAt String
  updatedAt DateTime @updatedAt

  @@map("BotRoom")
}

// A timezone-aware schedule that starts a workflow's run unattended.
// `nextRunAt` is precomputed so a tick is a single indexed query, and the
// record keeps the LAST outcome so a broken schedule is visible rather than
// silently retrying forever. `catchUp` decides what happens when the app was
// closed across one or more fire times: `skip` resumes at the next future
// occurrence; `coalesce` runs once immediately.
model WorkflowSchedule {
  id         String   @id @default(cuid())
  workflowId String
  // The trigger.schedule node this schedule belongs to, when created from the
  // node inspector. Null for schedules created from the execution dock before
  // the node link existed; they still fire.
  nodeId     String?
  name       String
  cron       String
  timezone   String   @default("UTC")
  enabled    Boolean  @default(true)
  catchUp    String   @default("skip") // skip | coalesce
  version    Int? // pinned workflow version; null = whatever is current
  lastRunAt  DateTime?
  lastRunId  String?
  lastStatus String?
  lastError  String?
  nextRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([workflowId])
  @@index([workflowId, nodeId])
}

// A verified inbound webhook linked to a trigger.webhook node. The secret is
// AES-256-GCM encrypted at rest (the same connector-secret store as connector
// credentials) and shown once on create/rotate. `mode: safe` runs the normal
// read-only TEST envelope; `mode: armed` pins the workflow version and the
// grants the operator confirmed, and refuses to run if the graph changed.
model WorkflowWebhook {
  id                String   @id @default(cuid())
  workflowId        String
  // The trigger.webhook node this endpoint belongs to. Null is allowed for a
  // webhook created before the node link existed; it still receives.
  nodeId            String?
  name              String
  // URL path segment. Random and not a secret: the secret is the signature/token.
  slug              String   @unique
  secretCipher      String
  secretHint        String
  enabled           Boolean  @default(true)
  mode              String   @default("safe") // safe | armed
  allowedMethods    String   @default("[\"POST\"]")
  responseMode      String   @default("immediate") // immediate | wait
  responseTimeoutMs Int      @default(10000)
  verificationMode  String   @default("hmac") // hmac | token | both
  // Set when armed: the exact workflow version + content hash + grants that the
  // operator confirmed. Any mismatch refuses the delivery until re-armed.
  version           Int?
  grantsJson        String?
  lastReceivedAt    DateTime?
  lastRunId         String?
  lastStatus        String?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, nodeId])
  @@index([enabled])
}

// Idempotency/replay window for a webhook delivery. `deliveryId` is the caller's
// X-Eclipse-Delivery (or Idempotency-Key); a duplicate returns the prior run
// instead of starting a second one. Rows expire and are purged opportunistically.
model WorkflowWebhookReceipt {
  id         String   @id @default(cuid())
  webhookId  String
  deliveryId String
  runId      String?
  receivedAt DateTime @default(now())
  expiresAt  DateTime

  @@unique([webhookId, deliveryId])
  @@index([expiresAt])
}

// One immutable snapshot of a workflow's canonical IR.
model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  version     Int
  ir          String // JSON: canonical Eclipse Workflow IR
  contentHash String
  note        String?
  createdAt   DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId, createdAt])
}

// -- User data tables (spreadsheet-style, n8n Data Tables equivalent) -------
// Operator-authored rows live here, separate from CustomDataset (connector-fed
// data) and from the canonical market tables. Both structured fields are JSON
// strings because Prisma + SQLite has no Json column in this project.
model DataTable {
  id          String   @id @default(cuid())
  name        String
  description String?
  columns     String // JSON: TableColumn[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rows DataTableRow[]

  @@index([updatedAt])
}

model DataTableRow {
  id        String   @id @default(cuid())
  tableId   String
  values    String // JSON: Record<columnId, unknown>
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  table DataTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, position])
}